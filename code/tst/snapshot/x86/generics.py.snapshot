def _print[T](item: T) -> None:
    print(item)

def print_len[T](_lst: list[T]) -> None:
    res = len(_lst)
    print(res)

def get_last_item[T](_lst: list[T]) -> T:
    length = len(_lst)
    return _lst[length - 1]

